# ==========================================
# EM'S BURGERS - PRODUCTION ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env and fill in your Firebase project credentials.
# Vite requires all client-side environment variables to start with VITE_

# Firebase Web App Configuration
# Get these values from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# EmailJS Configuration (Optional for email OTP dispatch)
VITE_EMAILJS_SERVICE_ID=service_hr66lq6
VITE_EMAILJS_TEMPLATE_ID=template_a4uounh
VITE_EMAILJS_PUBLIC_KEY=PJxI5gZ91dz4F5tLi

# ==========================================
# IMPORTANT: MULTI-DEVICE & MOBILE ACCESS NOTICE
# ==========================================
# To test or run the app on other devices (e.g. mobile phones on Wi-Fi, custom domains):
# 1. Open Firebase Console (https://console.firebase.google.com)
# 2. Go to Authentication -> Settings -> Authorized Domains
# 3. Add your local IP (e.g. 192.168.x.x) or your production domain (e.g. your-app.vercel.app)
# ==========================================
