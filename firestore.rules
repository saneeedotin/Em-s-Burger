rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      // Assuming admins have a custom claim 'admin' or their email is admin@emsburgers.com
      return isAuthenticated() && (
        request.auth.token.admin == true || 
        request.auth.token.email == 'admin@emsburgers.com'
      );
    }

    // Menu collection
    match /menu/{menuId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Reviews collection (e.g., from the About page corkboard)
    match /reviews/{reviewId} {
      allow read: if true;
      // Anyone can create a review if they are logged in, but only admins can delete/update
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // Orders collection
    match /orders/{orderId} {
      // Users can read/write their own orders
      allow read, update: if isAdmin() || isOwner(resource.data.user_id) || isOwner(resource.data.userId);
      // Anyone can create an order if they are authenticated, or we allow unauthenticated for tables?
      // Checkout.jsx handles both 'reception' and 'table' orders. For now, allow authenticated to create.
      allow create: if true; 
      allow delete: if isAdmin();
    }
    
    // Users profile collection
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    // Loyalty collection
    match /loyalty/{loyaltyId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid || isAdmin();
      allow write: if isAdmin();
    }
    
    // Fallback block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
