rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Customer Profiles (Admin Management & Customer Access)
    match /profiles/{userId} {
      allow read, write, delete: if true;
    }

    // Orders (Table QR Ordering, Reception & Kitchen Admin)
    match /orders/{orderId} {
      allow read, write, delete: if true;
    }

    // Menu Items & Categories (Live Menu CRUD)
    match /menu_items/{itemId} {
      allow read, write, delete: if true;
    }
    match /menu_categories/{categoryId} {
      allow read, write, delete: if true;
    }

    // Live Active Carts
    match /live_carts/{userId} {
      allow read, write, delete: if true;
    }

    // Customer Reviews
    match /reviews/{reviewId} {
      allow read, write, delete: if true;
    }

    // System Metadata (EMCODE Sequential Counter & QR Security Tokens)
    match /metadata/{docId} {
      allow read, write, delete: if true;
    }
  }
}
